local ui    = require("ui")
local tools = require("tools")
local M     = {}

-- Extrai conteudo entre open_tag e a PRIMEIRA ocorrencia de close_tag.
local function extract_first(s, open_tag, close_tag)
  local start = s:find(open_tag, 1, true)
  if not start then return nil end
  start = start + #open_tag
  local close_pos = s:find(close_tag, start, true)
  if not close_pos then return nil end
  return s:sub(start, close_pos - 1):match("^%s*(.-)%s*$") or ""
end

-- Extrai conteudo entre open_tag e a ULTIMA ocorrencia de close_tag.
local function extract_last(s, open_tag, close_tag)
  local start = s:find(open_tag, 1, true)
  if not start then return nil end
  start = start + #open_tag
  local last_end, pos = nil, start
  while true do
    local found = s:find(close_tag, pos, true)
    if not found then break end
    last_end = found
    pos = found + 1
  end
  if not last_end then return nil end
  return s:sub(start, last_end - 1):match("^%s*(.-)%s*$") or ""
end

-- Extrai blocos de nivel raiz respeitando aninhamento (depth tracking).
local function find_top_level_blocks(text, open_tag, close_tag)
  local blocks = {}
  local i = 1
  while i <= #text do
    local s = text:find(open_tag, i, true)
    if not s then break end
    local depth = 1
    local j = s + #open_tag
    local found_close = nil
    while j <= #text do
      local o = text:find(open_tag,  j, true)
      local c = text:find(close_tag, j, true)
      if not c then depth = -1; break end
      if o and o < c then
        depth = depth + 1
        j = o + #open_tag
      else
        depth = depth - 1
        if depth == 0 then found_close = c; break end
        j = c + #close_tag
      end
    end
    if found_close then
      local e = found_close + #close_tag - 1
        blocks[#blocks+1] = {s = s, e = e}
      i = e + 1
    else
      break
    end
  end
  return blocks
end

local function parse_format(texto_para_analise, texto_limpo, ferramentas, seen, open_tag, close_tag)
  local blocks = find_top_level_blocks(texto_para_analise, open_tag, close_tag)

  -- Itera de tras para frente para preservar offsets ao remover blocos
  for i = #blocks, 1, -1 do
    local b = blocks[i]

    -- Extrai string real e intacta usando coordenadas do texto_para_analise
    local tool_block_limpo = texto_limpo:sub(b.s, b.e)

    local nome = extract_first(tool_block_limpo, "<name>", "</name>")
    local arg  = extract_last(tool_block_limpo, "<arg>", "</arg>")
              or extract_last(tool_block_limpo, "<arguments>", "</arguments>") or ""

    if nome and nome ~= "" then
      if tools.registry[nome] then

        -- Remove o bloco do texto de exibicao (apenas para tools validas)
        texto_limpo = texto_limpo:sub(1, b.s - 1) .. texto_limpo:sub(b.e + 1)
        local sig = nome .. "||" .. arg
        if not seen[sig] then
          seen[sig] = true
          -- Insere no inicio para preservar ordem original (backwards)
          table.insert(ferramentas, 1, { nome = nome, arg = arg })
        end
      end
    end
  end
  return texto_limpo
end

local function strip_orphan_tags(texto)
  local parts = {}
  local in_code = false
  for line in (texto .. "\n"):gmatch("([^\n]*)\n") do
    if line:match("^%s*```") then in_code = not in_code end
    if not in_code then
      -- Preserva conteudo entre backticks simples
      local inline = {}
      line = line:gsub("`([^`]+)`", function(c)
        inline[#inline+1] = c
        return "\0IC" .. #inline .. "\0"
      end)

    parts[#parts + 1] = line
  end
  return table.concat(parts, "\n")
end

-- FIX: substitui o gsub("```.-```","") que era no-op para blocos multiline.
-- "." em Lua nao casa com \n, entao fences multiline passavam intactas e
-- tool calls dentro de exemplos eram executadas como chamadas reais.
-- Solucao: substituicao linha a linha com null bytes de MESMO comprimento.
-- Null bytes preservam posicoes dos bytes do texto original (tool blocks
-- reais continuam localizaveis em texto_limpo) e nunca casam com <tool>.
local function neutralize_code_fences(text)
  local parts = {}
  local in_fence = false
  for line in (text.."\n"):gmatch("([^\n]*)\n") do
    if line:match("^%s*```") then
      in_fence = not in_fence
      parts[#parts+1] = string.rep("\0", #line)
    elseif in_fence then
      parts[#parts+1] = string.rep("\0", #line)
    else
      -- Protege conteudo entre backticks simples com null bytes
      local n_line = line:gsub("`([^`]+)`", function(inner)
        return "`" .. string.rep("\0", #inner) .. "`"
      end)
      parts[#parts+1] = n_line
    end
  end
  return table.concat(parts, "\n")
end

function M.parsear(resp)
  local ferramentas = {}
  local texto_limpo = resp
  local texto_para_analise = neutralize_code_fences(resp)
  local seen = {}
  texto_limpo = parse_format(
    texto_para_analise, texto_limpo, ferramentas, seen, "<tool>", "</tool>")
  texto_limpo = parse_format(
    texto_para_analise, texto_limpo, ferramentas, seen, "<tool_call>", "</tool_call>")
  texto_limpo = strip_orphan_tags(texto_limpo)
  return texto_limpo:match("^%s*(.-)%s*$") or "", ferramentas
end

function M.executar(ferramentas)
  local resultados = {}
  for _, tool in ipairs(ferramentas) do
    local display = (tool.nome .. " | " .. tool.arg):gsub("\n", " ")
    if #display > 70 then display = display:sub(1, 70) .. "..." end
    ui.tool_start(display)
    local out = tools.call(tool.nome .. "|" .. tool.arg)
    local ok  = not out:match("^❌")
    ui.tool_end(display, out, ok)
    local result_text = out
    if not ok then
      result_text = out
        .. "\n\n[INSTRUCAO DO SISTEMA] Ferramenta falhou. Verifique:\n"
        .. "1. Nome correto? Ferramentas: exec, Read, Write, Edit, "
        .. "Find, List, pesquisar_web, sessao_status, memory_search, calcular\n"
        .. "2. Formato: <tool><name>NOME</name><arg>ARGUMENTO</arg></tool>\n"
        .. "3. Read antes de Edit/Write"
    end
    resultados[#resultados + 1] = string.format(
      '<tool_result name="%s" status="%s">\n%s\n</tool_result>',
      tool.nome, (ok and "ok" or "erro"), result_text)
  end
  return table.concat(resultados, "\n\n")
end

function M.executar_silent(ferramentas)
  local resultados = {}
  for _, tool in ipairs(ferramentas) do
    local out = tools.call(tool.nome .. "|" .. tool.arg)
    local ok  = not out:match("^❌")
    resultados[#resultados + 1] = string.format(
      '<tool_result name="%s" status="%s">\n%s\n</tool_result>',
      tool.nome, (ok and "ok" or "erro"), out)
  end
  return table.concat(resultados, "\n\n")
end

return M
